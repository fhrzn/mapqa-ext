    "def parse_element(elem: dict) -> OSMPOI | None:\n",
    "    tags = elem.get(\"tags\", {})\n",
    "\n",
    "    poi_class, poi_type = None, None\n",
    "    for cls in POI_CLASSES:\n",
    "        if cls in tags:\n",
    "            poi_class, poi_type = cls, tags[cls]\n",
    "            break\n",
    "    if not poi_class:\n",
    "        return None\n",
    "\n",
    "    if elem[\"type\"] == \"node\":\n",
    "        lat, lon = elem[\"lat\"], elem[\"lon\"]\n",
    "        bbox = [lat, lon, lat, lon]\n",
    "    else:\n",
    "        b = elem.get(\"bounds\", {})\n",
