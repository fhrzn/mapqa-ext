    "import requests\n",
    "\n",
    "\n",
    "def get_amenity_overpass(osm_id):\n",
    "    query = f\"\"\"                                                                                          \n",
    "    [out:json];                                                                                             \n",
    "    (\n",
    "    node({osm_id});                                                                                       \n",
    "    way({osm_id});                                                                                      \n",
    "    relation({osm_id});                                                                                 \n",
    "    );\n",
    "    out tags;                                                                                               \n",
    "    \"\"\"\n",
    "    resp = requests.post(\n",
    "        \"https://overpass-api.de/api/interpreter\", data={\"data\": query}\n",
    "    )\n",
    "    elements = resp.json().get(\"elements\", [])\n",
    "    if elements:\n",
    "        return elements[0].get(\"tags\", {}).get(\"amenity\")\n",
    "    return None"
   ]
